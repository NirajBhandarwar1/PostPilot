# Copy this file to .env and fill it in. Never commit .env.

# ---------- Models ----------
# Free models work on their own (just GROQ_API_KEY). For sharper ideas, add the Writer block below.
# Providers are tried in this order; if one fails the next one takes over.
LLM_PROVIDERS=groq,ollama

# ---------- Writer: the model that writes ideas, build plans and posts ----------
# Recommended: your OpenAI key first (GPT-6), free models as backup. Leave WRITER_PROVIDERS out and
# the LLM_PROVIDERS list above does all the writing (100% free, weaker ideas).
# WRITER_PROVIDERS=openai,groq,cloudflare
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-sol
# OPENAI_REASONING_EFFORT=medium
# Paid tokens PostPilot may use per day (code default 100000). Past it, the free backups write
# and the ideas email says so. About 12K tokens per batch, more per build plan.
# OPENAI_DAILY_TOKENS=300000
# on (default): ideas may run priced models and show an estimated cost. off: free models only.
# PAID_EXPERIMENTS=on
# Free Qwen3.8 on your Groq key, used by "qwen" in WRITER_PROVIDERS:
# QWEN_MODEL=qwen/qwen3.8-27b
# Cloudflare Workers AI (free tier, optional writer or model catalog):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# Groq: free tier, runs open-weight models fast. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high: how hard gpt-oss thinks before answering
REASONING_EFFORT=medium

# OpenRouter (optional backup): https://openrouter.ai/keys  (free models end in :free)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Ollama (optional, runs on this laptop, slow but fully offline): https://ollama.com
# OLLAMA_MODEL=qwen3:8b

# Any other OpenAI-compatible host, e.g. DeepSeek, Together, a rented GPU:
# CUSTOM_BASE_URL=https://api.deepseek.com/v1
# CUSTOM_MODEL=deepseek-chat
# CUSTOM_API_KEY=
# CUSTOM_STRICT=false

# ---------- Gmail ----------
# Turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (16 letters, spaces are fine)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Where ideas are sent. Leave empty to send to GMAIL_ADDRESS.
TO_EMAIL=

# ---------- Optional ----------
# GITHUB_TOKEN=            # raises GitHub's rate limit; not required
# CYCLE_DAYS=1            # days between scouts (default: every day)
# CHECK_MINUTES=10
